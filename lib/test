def False : prop := {A : prop} A

def True : prop := False -> False
def true-proof : True := [hf] hf

def ~ : prop -> prop := [A] A -> False

def /\ : prop -> prop -> prop := [A] [B] {C : prop} (A -> B -> C) -> C
def /\-intro : {A : prop} {B : prop} A -> B -> A /\ B
  := [A] [B] [ha] [hb] [C] [f] f(ha, hb)
def /\-elim-l : {A : prop} {B : prop} (A /\ B) -> A
  := [A] [B] [hab] hab(A, [ha] [_] ha)
def /\-elim-r : {A : prop} {B : prop} (A /\ B) -> B
  := [A] [B] [hab] hab(B, [_] [hb] hb)

def \/ : prop -> prop -> prop := [A] [B] {C : prop} (A -> C) -> (B -> C) -> C
def \/-intro-l : {A : prop} {B : prop} A -> A \/ B
  := [A] [B] [ha] [C] [f] [_] f(ha)
def \/-intro-r : {A : prop} {B : prop} B -> A \/ B
  := [A] [B] [hb] [C] [_] [f] f(hb)
def \/-elim
  : {A : prop} {B : prop} {C : prop} (A \/ B) -> (A -> C) -> (B -> C) -> C
  := [A] [B] [C] [hab] hab(C)

def <-> : prop -> prop -> prop := [A] [B] (A -> B) /\ B -> A

def = : {A : prop} A -> A -> prop := [A] [x] [y] {P : A -> prop} P(x) -> P(y)
def =-refl : {A : prop} {x : A} x =@A x := [A] [x] [P] [hx] hx
def =-symm : {A : prop} {x : A} {y : A} (x =@A y) -> y =@A x
  := [A] [x] [y] [hxy] hxy([z] z =@A x, =-refl(A, x))
def =-trans
  : {A : prop} {x : A} {y : A} {z : A} (x =@A y) -> (y =@A z) -> x =@A z
  := [A] [x] [y] [z] [hxy] [hyz] [P] [hx] hyz(P, hxy(P, hx))

axiom excluded-middle : {A : prop} A \/ ~(A)
def double-negation-elim : {A : prop} ~(~(A)) -> A
  := [A] [hnna]
    let a->a := [ha : A] ha in
    let ~a->a : ~(A) -> A := [hna] hnna(hna, A) in
    \/-elim(A, ~(A), A, excluded-middle(A), a->a, ~a->a)
